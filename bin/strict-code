#!/bin/sh
# strict-code CLI — pin the skill to the latest stable tag, cut releases.
#
# Install:
#   git clone https://github.com/yanpenalva/strict-code.git ~/.local/share/strict-code
#   ln -s ~/.local/share/strict-code/bin/strict-code ~/.local/bin/strict-code
#
# Usage:
#   strict-code update [path]   fetch tags, checkout latest stable tag (default: enclosing skill copy)
#   strict-code release 1.2.0   (maintainer) bump, commit, tag, push, GitHub release
#   strict-code version [path]  print the installed version
set -eu

cmd="${1:-help}"
arg="${2:-}"

resolve_root() {
  if [ -n "$arg" ]; then
    [ -f "$arg/SKILL.md" ] || { echo "Not a strict-code copy: $arg" >&2; exit 1; }
    (cd "$arg" && pwd)
    return
  fi
  dir="$PWD"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/SKILL.md" ] && grep -q '^name: strict-code$' "$dir/SKILL.md"; then
      echo "$dir"
      return
    fi
    dir="$(dirname "$dir")"
  done
  echo "Run inside a strict-code copy or pass its path." >&2
  exit 1
}

case "$cmd" in
  update)
    root="$(resolve_root)"
    cd "$root"
    [ -d .git ] || { echo "Not a git checkout: $root" >&2; exit 1; }
    git fetch --tags origin
    latest="$(git tag --list 'v[0-9]*' --sort=-v:refname | head -n 1)"
    [ -n "$latest" ] || { echo "No stable tag found." >&2; exit 1; }
    current="$(git describe --tags --always)"
    if [ "$current" = "$latest" ]; then
      echo "Already at latest stable ($latest) — $root"
    else
      git checkout -q "$latest"
      echo "Updated $current -> $latest — $root"
    fi
    ;;
  version)
    root="$(resolve_root)"
    grep '^version: ' "$root/SKILL.md" | head -n 1
    ;;
  release)
    VERSION="$arg"
    echo "$VERSION" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || { echo "Usage: strict-code release <major.minor.patch>" >&2; exit 1; }
    TAG="v$VERSION"
    arg=""
    root="$(resolve_root)"
    cd "$root"
    [ -f SKILL.md ] && [ -f CHANGELOG.md ] || { echo "Not a strict-code checkout: $root" >&2; exit 1; }
    dirty="$(git status --short | grep -v ' CHANGELOG.md$' | grep -v ' SKILL.md$' || true)"
    [ -z "$dirty" ] || { echo "Working tree has non-release changes — commit first:" >&2; echo "$dirty" >&2; exit 1; }
    git rev-parse "$TAG" >/dev/null 2>&1 && { echo "Tag $TAG already exists." >&2; exit 1; }
    grep -q "^## $VERSION$" CHANGELOG.md || { echo "CHANGELOG.md lacks a '## $VERSION' entry." >&2; exit 1; }
    command -v gh >/dev/null || { echo "gh CLI not found." >&2; exit 1; }
    sed "s/^version: .*/version: $VERSION/" SKILL.md > SKILL.md.tmp && mv SKILL.md.tmp SKILL.md
    grep -q "^version: $VERSION$" SKILL.md || { echo "SKILL.md version bump failed." >&2; exit 1; }
    git add SKILL.md CHANGELOG.md
    git commit -m "chore(release): bump to $TAG"
    git tag "$TAG"
    git push origin main
    git push origin "$TAG"
    gh release create "$TAG" --repo yanpenalva/strict-code --title "$TAG" \
      --notes "$(awk "/^## $VERSION\$/{flag=1;next}/^## /{flag=0}flag" CHANGELOG.md)"
    git fetch --tags origin
    echo "Released $TAG — local checkout at $(git describe --tags)."
    ;;
  *)
    echo "Usage: strict-code {update [path]|release <version>|version [path]}" >&2
    exit 1
    ;;
esac
