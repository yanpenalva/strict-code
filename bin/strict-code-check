#!/usr/bin/env python3
"""Rule-consistency check for a strict-code copy.

Validates what a prose standard cannot: references resolve, the version matches
the changelog, every guide is reachable from SKILL.md, JSON examples parse, and
RIGHT examples contain no banned branch. Exit 1 on any failure.
"""

import json
import re
import sys
from pathlib import Path

BANNED_BRANCH = re.compile(r"\b(else|elseif|elif)\b|v-else")


def check(root: Path) -> list[str]:
    failures: list[str] = []
    skill = root / "SKILL.md"
    guides = sorted((root / "references").glob("*.md"))
    skill_text = skill.read_text()
    docs = {skill.name: skill_text}
    docs.update({f"references/{p.name}": p.read_text() for p in guides})

    # 1. Relative links and backticked .md references must exist.
    for name, body in docs.items():
        base = root / name
        for link in re.findall(r"\]\(([^)#\s][^)\s]*)\)", body):
            if link.startswith(("http://", "https://", "mailto:")):
                continue
            if not (base.parent / link).resolve().exists():
                failures.append(f"{name}: broken link -> {link}")
        for ref in re.findall(r"`([A-Za-z0-9_./-]+\.md)`", body):
            candidates = [base.parent / ref, root / ref, root / "references" / ref]
            if not any(candidate.resolve().exists() for candidate in candidates):
                failures.append(f"{name}: missing reference -> {ref}")

    # 2. Every guide is reachable from SKILL.md.
    cited = set(re.findall(r"`(?:references/)?([A-Za-z0-9_-]+\.md)`", skill_text))
    for guide in guides:
        if guide.name not in cited:
            failures.append(f"references/{guide.name}: not cited from SKILL.md")

    # 3. Frontmatter version equals the newest changelog version.
    declared = re.search(r"^version:\s*(\S+)\s*$", skill_text, re.M)
    changelog = re.search(
        r"^##\s+(\d+\.\d+\.\d+)\s*$", (root / "CHANGELOG.md").read_text(), re.M
    )
    if not declared or not changelog:
        failures.append("version: frontmatter or CHANGELOG heading missing")
    elif declared.group(1) != changelog.group(1):
        failures.append(
            f"version: SKILL.md {declared.group(1)} != CHANGELOG {changelog.group(1)}"
        )

    # 4. Fenced JSON blocks must parse, one document per line or block.
    for name, body in docs.items():
        for block in re.findall(r"```json\n(.*?)```", body, re.S):
            try:
                json.loads(block)
                continue
            except json.JSONDecodeError:
                pass
            for line in block.strip().splitlines():
                try:
                    json.loads(line)
                except json.JSONDecodeError as error:
                    failures.append(
                        f"{name}: invalid JSON example ({error.msg}) -> {line.strip()[:60]}"
                    )

    # 5. RIGHT examples never show a banned branch.
    for name, body in docs.items():
        for block in re.findall(r"```[a-z]*\n(.*?)```", body, re.S):
            for wrong_segment in block.split("WRONG")[1:]:
                for right_segment in wrong_segment.split("RIGHT")[1:]:
                    if BANNED_BRANCH.search(right_segment):
                        failures.append(f"{name}: banned branch in a RIGHT example")
    return failures


def main() -> int:
    root = Path(sys.argv[1] if len(sys.argv) > 1 else ".")
    if not (root / "SKILL.md").is_file():
        print(f"Not a strict-code copy: {root}")
        return 1
    failures = check(root)
    for failure in failures:
        print(f"FAIL {failure}")
    print(f"{len(failures)} failure(s)" if failures else "OK")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
